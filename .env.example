# .env.example - copia a .env y ajusta. .env NO se versiona.
# Aqui va SOLO configuracion no secreta. Los secretos viven en secrets/*.txt
# (generados con scripts/generar-secretos.sh) y se referencian por *_FILE.

# ---------------------------------------------------------------------------
# Docker Compose (interpolacion en compose.yaml)
# ---------------------------------------------------------------------------
# Puerto del anfitrion para la web. Cambialo si el 8080 esta ocupado.
WEB_PORT=8080
# Version que reporta /quien y etiqueta de la imagen de la API.
APP_VERSION=1.0
# Segundos que un listado vive en la cache Redis.
CACHE_TTL=30
JWT_EXP_HOURS=8

# ---------------------------------------------------------------------------
# Desarrollo local sin contenedores (python run.py + npm run dev)
# ---------------------------------------------------------------------------
# Secretos por archivo (rutas relativas a la raiz del repo):
JWT_SECRET_FILE=secrets/jwt_secret.txt
# Para tu MySQL local puedes usar un archivo propio, p. ej.
# secrets/db_password_local.txt (secrets/ esta ignorado por Git):
DB_PASSWORD_FILE=secrets/db_password_local.txt
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=ingenieria_web
# Sin REDIS_HOST la cache queda desactivada.
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD_FILE=secrets/redis_password.txt
PORT=5000
FLASK_DEBUG=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
